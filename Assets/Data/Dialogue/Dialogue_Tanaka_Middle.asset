  m_Script: {fileID: 11500000, guid: 684902a2cd4c2b94cabc2e2fb15c53dc, type: 3}
  m_Name: Dialogue_Tanaka_Middle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u3010\u90E8\u9577\u3011\u7530\u4E2D"
  lines:
  - "\u2026\u2026\u4ED5\u4E8B\u306E\u65B9\u306F\u3069\u3046\u3060\uFF1F \u9032\u3093\u3067\u308B\u304B\uFF1F"
  choices:
  - text: "\u9032\u6357\u3088\u308A\u3001\n\u3042\u306A\u305F\u3068\u8A71\u305B\u308B\u6642\u9593\u306E\u65B9\u304C\n\u5927\u4E8B\u3067\u3059"
    ikdDelta: 250
    route: 0
    responseLines:
    - "\u2026\u2026\u4F55\u3092\u8A00\u3063\u3066\u308B\u3093\u3060"
  - text: "\u9806\u8ABF\u3067\u3059\u3002\u4E88\u5B9A\u901A\u308A\u9032\u3093\u3067\u307E\u3059"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u2026\u2026\u305D\u3046\u304B\u3002\u983C\u3080\u305E"
  - text: "\u9032\u6357\u3067\u3059\u304B\uFF1F\n\u79C1\u306F\u3082\u3046\u5225\u306E\u4F1A\u793E\u306E\u4EBA\u9593\u306A\u306E\u3067\n\u5B58\u3058\u4E0A\u3052\u307E\u305B\u3093"
    ikdDelta: 450
    route: 2
    responseLines:
    - "\u2026\u2026\u304A\u524D\u3001\u4ECA\u65E5\u304C\u6700\u7D42\u65E5\u3060\u3063\u3066\u308F\u304B\u3063\u3066\u308B\u304B"
  - text: "\u3042\u306A\u305F\u306B\u5831\u544A\u3059\u308B\u7FA9\u7406\u306F\n\u3082\u3046\u306A\u3044\u3067\u3059\u3088\u306D"
    ikdDelta: 350
    route: 3
    responseLines:
    - "\u2026\u2026\u305D\u3046\u3060\u306A\u3001\u60AA\u304B\u3063\u305F"
  advancesToMiddlePhase: 0
  triggersEnding: 0
