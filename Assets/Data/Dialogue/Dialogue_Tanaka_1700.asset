  m_Script: {fileID: 11500000, guid: 684902a2cd4c2b94cabc2e2fb15c53dc, type: 3}
  m_Name: Dialogue_Tanaka_1700
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u3010\u90E8\u9577\u3011\u7530\u4E2D"
  lines:
  - "\u2026\u2026\u6700\u5F8C\u306B\u3001\u3072\u3068\u3064\u3060\u3051\u805E\u3044\u3066\u3044\u3044\u304B\uFF1F"
  choices:
  - text: "\u50D5\u304B\u3089\u3082\u3072\u3068\u3064\u3002\n\u2026\u2026\u4ECA\u591C\u3001\u7A7A\u3044\u3066\u307E\u3059\u304B\uFF1F"
    ikdDelta: 400
    route: 0
    responseLines:
    - "\u2026\u2026\u5E30\u308C"
  - text: "\u306F\u3044\u3001\u306A\u3093\u3067\u3057\u3087\u3046"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u2026\u2026\u3053\u3053\u3067\u5B66\u3093\u3060\u3053\u3068\u3001\u7121\u99C4\u306B\u3059\u308B\u306A\u3088"
  - text: "\u30AF\u30D3\u306F\u8A8D\u3081\u307E\u305B\u3093\u3002\n\u660E\u65E5\u3082\u6765\u307E\u3059"
    ikdDelta: 1000
    route: 2
    responseLines:
    - "\u2026\u2026\u2026\u2026\u3082\u3046\u3044\u3044\u3002\u5E30\u3063\u3066\u304F\u308C"
  - text: "\u805E\u304F\uFF1F \u3053\u3063\u3061\u306F\u805E\u3044\u3066\u307B\u3057\u3044\u3053\u3068\n\u5C71\u307B\u3069\u3042\u308B\u3093\u3067\u3059\u3051\u3069"
    ikdDelta: 400
    route: 3
    responseLines:
    - "\u2026\u2026\u3059\u307E\u306A\u304B\u3063\u305F\u3002\u3060\u304C\u3001\u3082\u3046\u6C7A\u307E\u3063\u305F\u3053\u3068\u3060"
  advancesToMiddlePhase: 0
  triggersEnding: 1
