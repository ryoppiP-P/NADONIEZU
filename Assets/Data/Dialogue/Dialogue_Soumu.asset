  - text: "\u793E\u54E1\u8A3C\u306F\u8FD4\u3059\u306E\u3067\u3001\u4EE3\u308F\u308A\u306B\u3042\u306A\u305F\u306E\u9023\u7D61\u5148\u304F\u3060\u3055\u3044"
