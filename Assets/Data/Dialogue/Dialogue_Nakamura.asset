  m_Script: {fileID: 11500000, guid: 684902a2cd4c2b94cabc2e2fb15c53dc, type: 3}
  m_Name: Dialogue_Nakamura
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u3010\u53D6\u5F15\u5148\u3011\u4E2D\u6751"
  lines:
  - "\u3042\u3001\u62C5\u5F53\u306E\u65B9\u3067\u3059\u304B\uFF1F \u5F8C\u4EFB\u306E\u65B9\u306F\u3069\u3061\u3089\u306B\uFF1F"
  choices:
  - text: "\u5F8C\u4EFB\u3088\u308A\u3001\n\u4ECA\u3053\u3053\u306B\u3044\u308B\u50D5\u3092\u898B\u3066\u307B\u3057\u3044"
    ikdDelta: 300
    route: 0
    responseLines:
    - "\u3048\u3063\u3068\u2026\u2026\u30D3\u30B8\u30CD\u30B9\u306E\u8A71\u3092\u2026\u2026"
  - text: "\u5F8C\u4EFB\u306F\u6765\u9031\u7740\u4EFB\u4E88\u5B9A\u3067\u3059\u3002\n\u5F15\u304D\u7D99\u304E\u8CC7\u6599\u3092\u7F6E\u3044\u3066\u304A\u304D\u307E\u3059"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u627F\u77E5\u3057\u307E\u3057\u305F\u3002\u3054\u4E01\u5BE7\u306B\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059"
  - text: "\u5F8C\u4EFB\u306F\u5B58\u5728\u3057\u307E\u305B\u3093\u3002\n\u3053\u306E\u4F1A\u793E\u306F\u4ECA\u65E5\u3067\u7D42\u308F\u308A\u3067\u3059"
    ikdDelta: 500
    route: 2
    responseLines:
    - "\u3048\u3001\u3061\u3087\u3063\u3068\u2026\u2026\u672C\u6C17\u3067\u3059\u304B"
  - text: "\u3053\u306E\u4F1A\u793E\u3068\u306F\u53D6\u5F15\u3084\u3081\u305F\u307B\u3046\u304C\u3044\u3044\u3067\u3059\u3088\u3002\n\u8150\u3063\u3066\u308B\u3093\u3067"
    ikdDelta: 350
    route: 3
    responseLines:
    - "\u3042\u3001\u3042\u306F\u306F\u2026\u2026\u305D\u3046\u306A\u3093\u3067\u3059\u304B\u2026\u2026"
  advancesToMiddlePhase: 0
  triggersEnding: 0
