  m_Script: {fileID: 11500000, guid: 684902a2cd4c2b94cabc2e2fb15c53dc, type: 3}
  m_Name: Dialogue_Yamada
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u5C71\u7530\u5E38\u52D9"
  lines:
  - "\u3084\u3042\u3002\u307E\u3042\u5EA7\u308A\u306A\u3055\u3044\u3002\u2026\u2026\u8272\u3005\u3042\u3063\u305F\u304C\u3001\u6700\u5F8C\u306B\u5C11\u3057\u8A71\u305D\u3046"
  choices:
  - text: "\u90E8\u9577\u306E\u9999\u6C34\u3001\u3044\u3064\u3082\u3044\u3044\u5302\u3044\u3067\u3059\u3088\u306D\u2026\u2026\u6700\u5F8C\u306B\u55C5\u304C\u305B\u3066\u304F\u3060\u3055\u3044"
    ikdDelta: 300
    route: 0
    responseLines:
    - "\u2026\u2026\u4ED5\u4E8B\u306E\u8A71\u3092\u3057\u3088\u3046"
  - text: "\u306F\u3044\u3001\u304A\u6642\u9593\u3044\u305F\u3060\u304D\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u541B\u306B\u306F\u3044\u308D\u3044\u308D\u4E16\u8A71\u306B\u306A\u3063\u305F\u306A"
  - text: "\u6905\u5B50\u3067\u306F\u306A\u304F\u90E8\u9577\u306E\u30C7\u30B9\u30AF\u306E\u4E0A\u306B\u5EA7\u308B"
    ikdDelta: 500
    route: 2
    responseLines:
    - "\u304A\u3044\uFF01 \u964D\u308A\u306A\u3055\u3044\uFF01"
  - text: "\u8272\u3005\u3042\u3063\u305F\uFF1F \u3042\u3093\u305F\u304C\u4E00\u65B9\u7684\u306B\u3084\u3063\u305F\u3053\u3068\u3060\u308D"
    ikdDelta: 400
    route: 3
    responseLines:
    - "\u2026\u2026\u305D\u3046\u3044\u3046\u614B\u5EA6\u3060\u304B\u3089\u3001\u3053\u3046\u306A\u3063\u305F\u3093\u3060"
  advancesToMiddlePhase: 0
  triggersEnding: 0
