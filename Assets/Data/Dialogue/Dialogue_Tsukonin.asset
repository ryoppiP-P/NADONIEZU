  speakerName: "\u901A\u884C\u4EBA\u306E\u304A\u3063\u3061\u3083\u3093"
  lines:
  - "\u304A\u3001\u5144\u3061\u3083\u3093\u4ECA\u65E5\u3082\u4F1A\u793E\u304B\u3044\u3002\u2026\u2026\u306A\u3093\u3061\u3085\u3046\u9854\u3057\u3068\u308B\u3093\u3084\u3001\u89AA\u306E\u304B\u305F\u304D\u3067\u3082\u898B\u3064\u3051\u305F\u307F\u305F\u3044\u306A\u9854\u3057\u3066"
  - "\u30EF\u30B7\u306B\u306F\u308F\u304B\u308B\u3067\u3002\u304A\u307E\u3048\u3055\u3093\u3001\u4ECA\u65E5\u306A\u3093\u304B\u3084\u3089\u304B\u3059\u9854\u3057\u3068\u308B"
  - "\u307E\u3042\u6B62\u3081\u3078\u3093\u3051\u3069\u306A\u3002\u30EF\u30B7\u306F\u4F55\u3041\u301C\u3082\u898B\u3066\u3078\u3093\u3002\u307B\u306A\u3001\u3044\u3063\u3066\u3089\u3063\u3057\u3083\u3044"
