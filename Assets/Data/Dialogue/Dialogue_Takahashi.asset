  m_Name: Dialogue_Takahashi
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u9AD8\u6A4B"
  lines:
  - "\u5099\u54C1\u306E\u8FD4\u5374\u304A\u9858\u3044\u3057\u307E\u3059\u306D\u3002\u793E\u54E1\u8A3C\u3068PC\u3092\u3053\u3061\u3089\u306B"
  choices:
  - text: "\u793E\u54E1\u8A3C\u306F\u8FD4\u3059\u306E\u3067\u3001\u4EE3\u308F\u308A\u306B\u3042\u306A\u305F\u306E\u9023\u7D61\u5148\u304F\u3060\u3055\u3044"
    ikdDelta: 250
    route: 0
    responseLines:
    - "\u696D\u52D9\u4E2D\u306A\u306E\u3067\u2026\u2026"
  - text: "\u306F\u3044\u3001\u3053\u3061\u3089\u3067\u3059"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u78BA\u8A8D\u3057\u307E\u3057\u305F\u3002\u304A\u75B2\u308C\u69D8\u3067\u3057\u305F"
  - text: "\u793E\u54E1\u8A3C\u3092\u53E3\u306B\u5165\u308C\u308B"
    ikdDelta: 500
    route: 2
    responseLines:
    - "\u3061\u3087\u3001\u3084\u3081\u3066\u304F\u3060\u3055\u3044\uFF01"
  - text: "\u4E0D\u5F53\u89E3\u96C7\u306A\u3093\u3067\u8FD4\u3059\u7FA9\u52D9\u306A\u3044\u3068\u601D\u3044\u307E\u3059\u3051\u3069"
    ikdDelta: 350
    route: 3
    responseLines:
    - "\u898F\u5B9A\u3067\u3059\u306E\u3067"
  advancesToMiddlePhase: 0
  triggersEnding: 0
