  m_Name: Dialogue_Joushi_0900
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u4E0A\u53F8"
  lines:
  - "\u2026\u304A\u3046\u3002\u2026\u2026\u4ECA\u65E5\u3001\u6700\u5F8C\u3060\u306A\u3002\u307E\u3042\u3001\u3088\u308D\u3057\u304F\u983C\u3080"
  choices:
  - text: "\u6700\u5F8C\u306A\u3093\u3067\u8A00\u3044\u307E\u3059\u3002\u2026\u2026\u305A\u3063\u3068\u597D\u304D\u3067\u3057\u305F"
    ikdDelta: 400
    route: 0
  - text: "\u306F\u3044\u3002\u6700\u5F8C\u307E\u3067\u3061\u3083\u3093\u3068\u3084\u308A\u307E\u3059"
    ikdDelta: 0
    route: 1
  - text: "\u77E5\u3089\u306A\u3044\u4EBA\u306B\u8A71\u3057\u304B\u3051\u3089\u308C\u3066\u3082\u56F0\u308A\u307E\u3059"
    ikdDelta: 1000
    route: 2
  - text: "\u3088\u308D\u3057\u304F\uFF1F \u30AF\u30D3\u306B\u3057\u305F\u306E\u305D\u3063\u3061\u3067\u3059\u3088\u306D"
    ikdDelta: 300
    route: 3
