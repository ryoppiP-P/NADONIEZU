  speakerName: "\u4E0A\u53F8"
  lines:
  - "\u2026\u2026\u6700\u5F8C\u306B\u3001\u3072\u3068\u3064\u3060\u3051\u805E\u3044\u3066\u3044\u3044\u304B\uFF1F"
  choices:
  - text: "\u50D5\u304B\u3089\u3082\u3072\u3068\u3064\u3002\u2026\u2026\u4ECA\u591C\u3001\u7A7A\u3044\u3066\u307E\u3059\u304B\uFF1F"
    ikdDelta: 400
    route: 0
  - text: "\u306F\u3044\u3001\u306A\u3093\u3067\u3057\u3087\u3046"
    ikdDelta: 0
    route: 1
  - text: "\u30AF\u30D3\u306F\u8A8D\u3081\u307E\u305B\u3093\u3002\u660E\u65E5\u3082\u6765\u307E\u3059"
    ikdDelta: 1000
    route: 2
  - text: "\u805E\u304F\uFF1F \u3053\u3063\u3061\u306F\u805E\u3044\u3066\u307B\u3057\u3044\u3053\u3068\u5C71\u307B\u3069\u3042\u308B\u3093\u3067\u3059\u3051\u3069"
