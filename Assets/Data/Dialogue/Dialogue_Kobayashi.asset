  m_Script: {fileID: 11500000, guid: 684902a2cd4c2b94cabc2e2fb15c53dc, type: 3}
  m_Name: Dialogue_Kobayashi
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "\u5C0F\u6797"
  lines:
  - "\u304A\u75B2\u308C\u69D8\u3067\u3059\u3002\u4ECA\u65E5\u3067\u6700\u5F8C\u306A\u3093\u3067\u3059\u306D\u2026\u2026\u5BC2\u3057\u304F\u306A\u308A\u307E\u3059"
  choices:
  - text: "\u6BCE\u671D\u3042\u306A\u305F\u306E\u7B11\u9854\u304C\n\u898B\u3089\u308C\u306A\u304F\u306A\u308B\u306E\u304C\u3001\u4E00\u756A\u3064\u3089\u3044\u3067\u3059"
    ikdDelta: 250
    route: 0
    responseLines:
    - "\u305D\u3093\u306A\u2026\u2026\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059"
  - text: "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\n\u304A\u4E16\u8A71\u306B\u306A\u308A\u307E\u3057\u305F"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u3053\u3061\u3089\u3053\u305D\u3002\u304A\u5143\u6C17\u3067"
  - text: "\u6700\u5F8C\u3058\u3083\u306A\u3044\u3002\u660E\u65E5\u3082\u6765\u308B\u3002\n\u6BCE\u65E5\u6765\u308B\u3002\u53D7\u4ED8\u306E\u5916\u3067\u5F85\u3063\u3066\u308B"
    ikdDelta: 500
    route: 2
    responseLines:
    - "\u2026\u2026\u3048\u3001\u305D\u308C\u306F\u2026\u2026"
  - text: "\u5BC2\u3057\u3044\uFF1F\n\u4FFA\u304C\u30AF\u30D3\u306B\u3055\u308C\u305F\u65E5\u3001\u7B11\u3063\u3066\u307E\u3057\u305F\u3088\u306D"
    ikdDelta: 300
    route: 3
    responseLines:
    - "\u3048\u2026\u2026\u7B11\u3063\u3066\u3001\u306A\u3044\u3001\u3067\u3059\u2026\u2026"
  advancesToMiddlePhase: 0
  triggersEnding: 0
