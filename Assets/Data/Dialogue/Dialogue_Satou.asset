  speakerName: "\u4F50\u85E4"
  lines:
  - "\u5148\u8F29\u3001\u5F15\u304D\u7D99\u304E\u306E\u66F8\u985E\u3063\u3066\u3069\u3053\u3067\u3059\u304B\uFF1F"
  choices:
  - text: "\u66F8\u985E\u3088\u308A\u3001\n\u4FFA\u305F\u3061\u306E\u601D\u3044\u51FA\u3092\u5F15\u304D\u7D99\u304C\u306A\u3044\u304B\uFF1F"
    ikdDelta: 200
    route: 0
    responseLines:
    - "\u3048\u3001\u3048\u3063\u3068\u2026\u2026"
  - text: "\u5171\u6709\u30D5\u30A9\u30EB\u30C0\u306E\n\u7B2C3\u968E\u5C64\u306B\u3042\u308B\u3088"
    ikdDelta: 0
    route: 1
    responseLines:
    - "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01"
  - text: "\u66F8\u985E\u306A\u3093\u3066\u3082\u306E\u306F\n\u3053\u306E\u4E16\u306B\u5B58\u5728\u3057\u306A\u3044"
    ikdDelta: 500
    route: 2
    responseLines:
    - "\u2026\u2026\u3048\uFF1F"
  - text: "\u81EA\u5206\u3067\u63A2\u305B\u3002\n\u4FFA\u306F\u3082\u3046\u95A2\u4FC2\u306A\u3044"
    ikdDelta: 300
    route: 3
    responseLines:
    - "\u305D\u3046\u3001\u3067\u3059\u304B\u2026\u2026"
